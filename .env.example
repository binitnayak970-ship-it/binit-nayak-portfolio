# ---------------------------------------------------------------------------
# Supabase — required for the contact form and the page-view counter.
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key (anon / publishable key). Safe to expose to the browser ONLY
# because RLS blocks all reads on `messages` and only allows inserts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_, never
# import it into a client component. Used by the contact route and the counter.
SUPABASE_SERVICE_ROLE_KEY=
